{
    "name": "@harmoniclabs/buildooor",
    "version": "0.2.8",
    "description": "Cardano transaction builder in typescript",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "browser": {
        "worker_threads": false
    },
    "type": "commonjs",
    "files": [
        "dist"
    ],
    "scripts": {
        "test": "jest",
        "clear-jest": "jest --clearCache",
        "test-watch": "jest --watchman",
        "test-coverage": "jest --coverage",
        "build": "rm -rf ./dist && tsc --project ./tsconfig.json && tsc-alias -p ./tsconfig.json",
        "build:light": "tsc --project ./tsconfig.json && tsc-alias -p ./tsconfig.json",
        "buidl": "npm run build",
        "ci": "npm i && npm run test && npm run build",
        "start": "npm-run-all --parallel build:watch run:watch"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org"
    },
    "keywords": [
        "cardano",
        "plutus",
        "blockchain",
        "offchain",
        "ada",
        "dApp"
    ],
    "author": "Michele Nuzzi",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HarmonicLabs/plu-ts.git"
    },
    "bugs": {
        "url": "https://github.com/HarmonicLabs/plu-ts/issues"
    },
    "homepage": "https://github.com/HarmonicLabs/plu-ts#readme",
    "dependencies": {
        "@harmoniclabs/bigint-utils": "^1.0.0",
        "@harmoniclabs/bip32_ed25519": "^0.1.3",
        "@harmoniclabs/bytestring": "^1.0.0",
        "@harmoniclabs/cardano-costmodels-ts": "^1.4.0",
        "@harmoniclabs/cardano-ledger-ts": "file:./harmoniclabs-cardano-ledger-ts-0.5.2.tgz",
        "@harmoniclabs/cbor": "^2.0.1",
        "@harmoniclabs/crypto": "^0.3.0",
        "@harmoniclabs/obj-utils": "^1.0.0",
        "@harmoniclabs/pair": "^1.0.0",
        "@harmoniclabs/plutus-data": "^2.0.1",
        "@harmoniclabs/plutus-machine": "^3.0.2",
        "@harmoniclabs/uint8array-utils": "^1.0.4",
        "@harmoniclabs/uplc": "^2.0.6"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.18.6",
        "@babel/preset-typescript": "^7.18.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^18.14.6",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.3.0",
        "tsc-alias": "^1.7.1",
        "typescript": "^4.6.3"
    },
    "funding": "https://github.com/sponsors/HarmonicLabs"
}
